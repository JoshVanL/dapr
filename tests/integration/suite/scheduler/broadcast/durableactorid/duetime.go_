	t.Run("close stream between duetime, no event", func(t *testing.T) {
		newStream := d.scheduler.WatchJobs(t, ctx, "namespace", "appid")
		d.scheduler.Schedule(t, ctx, durableactorid.ScheduleOptions{
			Namespace: "namespace",
			AppID:     "appid",
			ActorType: "actortype",
			ActorID:   "actorid4",
			DueTime:   time.Now().Add(time.Second * 2),
		})

		require.NoError(t, newStream.CloseSend())

		time.Sleep(time.Second * 3)

		newStream = d.scheduler.WatchJobs(t, ctx, "namespace", "appid")

		opts := durableactorid.ExpectReceiveOptions{
			Namespace: "namespace",
			AppID:     "appid",
			ActorType: "actortype",
			ActorID:   "actorid4",
			Data:      nil,
		}

		d.scheduler.ExpectReceivePut(t, ctx, newStream, opts)
		d.scheduler.ExpectReceiveDelete(t, ctx, newStream, opts)
